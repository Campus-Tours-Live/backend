# Backend environment — TEMPLATE. Copy to backend/.env (git-ignored) and fill in your own values.
#
# The dev launcher (campus-tours-live: `npm run start:backend` / `start:all`) seeds backend/.env
# from this file on first run and loads it into the Spring Boot process — Spring Boot does NOT read
# .env itself. An explicitly-exported shell variable overrides the .env value. Never commit real
# secrets; only this .example template is tracked.

# --- Auth (Google Sign-In / OIDC) ---
# The Google OAuth Client ID. It must appear in every id_token's "aud" claim (AudienceValidator),
# and must MATCH bff's GOOGLE_CLIENT_ID and the Google Console client (see the hub's cross-repo
# environment contract). Leave blank for keyless local Core ONLY together with
# ALLOW_INSECURE_AUDIENCE=true below.
GOOGLE_CLIENT_ID=

# Local-dev escape hatch: lets the backend BOOT with a blank GOOGLE_CLIENT_ID by accepting ANY
# validly-signed Google id_token (no audience check). With it unset/false, a blank audience makes
# startup FAIL FAST. NEVER set this in staging/prod — it disables the audience guard.
ALLOW_INSECURE_AUDIENCE=true

# --- College Scorecard (live university / major directory for guide onboarding) ---
# Each developer uses their OWN free key — sign up at https://api.data.gov/signup/.
# Blank key → /meta/universities and /meta/majors return an empty list (the app still runs).
SCORECARD_API_KEY=

# Optional: override the Scorecard base URL (defaults to the public api.data.gov endpoint).
# SCORECARD_BASE_URL=https://api.data.gov/ed/collegescorecard/v1

# --- Campus images (Cloudflare R2) ---
# Public base URL the backend prefixes onto each university's image_url. A default bucket is
# baked into application.properties, so local dev needs nothing here.
# CROSS-REPO: whatever host this resolves to must be allow-listed in the frontend's
# next.config.ts images.remotePatterns, or next/image refuses to render campus images and the
# /tours grid breaks. Change both together.
# CAMPUS_IMAGE_BASE_URL=https://pub-<bucket>.r2.dev/
