# --- Build output ---
target/
*.class

# --- Logs ---
*.log

# --- Environment / secrets (real .env stays local; only the template is committed) ---
.env
.env.*
!.env.example

# --- IDEs / editors ---
# Ignore user-specific IDE files, but keep the shared, committed config.
.idea/*
!.idea/externalDependencies.xml
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# --- OS ---
.DS_Store
Thumbs.db

# NOTE: the Maven wrapper (mvnw, mvnw.cmd, .mvn/wrapper/maven-wrapper.properties) IS
# committed on purpose so `./mvnw` works on a fresh clone — do not ignore .mvn/.

# Claude Code — personal settings (do not commit); share .claude/settings.json
.claude/settings.local.json

# --- Superpowers working artifacts — plans, specs, SDD ledgers, review write-ups ---
# They record how a change was arrived at, which goes stale the moment the code moves on. The
# code, its tests and README/CLAUDE.md are the shared source of truth. Keep these local.
# NOTE: docs/openapi-conventions.md is NOT this — it is real repo documentation that CLAUDE.md
# points contributors at, and it stays tracked.
.superpowers/
docs/superpowers/
